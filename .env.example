# ─── Database ────────────────────────────────────────────────────────────────
# Used by the app at runtime and by drizzle-kit for migrations.
# For Docker Compose the host is the service name "db".
DATABASE_URL=mysql://app:apppassword@db:3306/driveway

# ─── MySQL (Docker Compose only) ─────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=driveway
MYSQL_USER=app
MYSQL_PASSWORD=apppassword

# ─── Auth / Sessions ─────────────────────────────────────────────────────────
# Random secret used to sign JWT session cookies.  Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_me_to_a_random_32_byte_hex_string

# ─── App Identity ────────────────────────────────────────────────────────────
# Public app identifier used inside signed session tokens.
VITE_APP_ID=your_manus_app_id

# ─── Gemini API (image gen, LLM, edge detection) ──────────────────────────────
# Get a free API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_API_ENDPOINT=https://generativelanguage.googleapis.com

# ─── OpenAI API (voice transcription via Whisper) ─────────────────────────────
# Get an API key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ─── Google Maps API (reverse geocoding, geolocation) ────────────────────────
# Get an API key at https://console.cloud.google.com/apis/credentials
GOOGLE_MAPS_API_KEY=

# ─── S3 Storage (production file storage, replaces Forge storage proxy) ──────
# AWS SDK picks up credentials from AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
S3_BUCKET_NAME=

# ─── Owner bootstrap ─────────────────────────────────────────────────────────
# Optional: this email is granted admin access when the account is created.
OWNER_EMAIL=owner@example.com

# ─── App (optional) ──────────────────────────────────────────────────────────
PORT=3000
HOST=127.0.0.1
APP_PORT=3000          # host port mapped in docker-compose

# Public HTTPS origin for native mobile builds. Required when building an APK
# with bundled web assets, because the app cannot call same-origin /api routes
# from the Capacitor localhost origin.
VITE_API_BASE_URL=https://your-production-app.example.com

# Comma-separated extra origins allowed to call the API with credentials.
# Keep this tight; do not use wildcards.
MOBILE_ALLOWED_ORIGINS=https://your-production-app.example.com

# ─── PayPal (payment processing for Premium subscription) ───────────────────
# Get your client ID from PayPal Developer Dashboard: https://developer.paypal.com/dashboard/
# Use sandbox client ID for testing, production client ID for live payments
VITE_PAYPAL_CLIENT_ID=your_sandbox_client_id

# PayPal Subscription Plan ID (created in PayPal Developer Dashboard)
# This should match your recurring payment plan in PayPal
VITE_PAYPAL_PLAN_ID=your_paypal_plan_id
