# Production Environment Configuration
# Copy this to .env.production and fill in the actual values

# ─── Environment ─────────────────────────────────────────────────────────────────
NODE_ENV=production

# ─── Database (optional with in-memory fallback) ─────────────────────────────
# Production database URL (recommended for production)
# DATABASE_URL=mysql://user:password@prod-host:3306/driveway
# Leave unset to use in-memory database (not recommended for production)

# ─── Auth / Sessions ─────────────────────────────────────────────────────────
# Generate a new secure secret for production:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<GENERATE_NEW_SECURE_SECRET_FOR_PRODUCTION>

# ─── App Identity ────────────────────────────────────────────────────────────
VITE_APP_ID=drivewayestimatorpro_production

# ─── Gemini API (image gen, LLM, edge detection) ──────────────────────────────
# Get API key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>
GEMINI_API_ENDPOINT=https://generativelanguage.googleapis.com

# ─── OpenAI API (voice transcription via Whisper) ─────────────────────────────
# Get API key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=<YOUR_OPENAI_API_KEY>

# ─── Google Maps API (reverse geocoding, geolocation) ────────────────────────
# Get API key at: https://console.cloud.google.com/apis/credentials
# Enable "Geocoding API" and "Places API" in Google Cloud Console
GOOGLE_MAPS_API_KEY=<YOUR_GOOGLE_MAPS_API_KEY>

# ─── S3 Storage (production file storage) ─────────────────────────────────────
# AWS SDK picks up credentials from AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
# Or configure via AWS IAM roles for production
S3_BUCKET_NAME=<YOUR_S3_BUCKET_NAME>

# ─── Owner bootstrap ─────────────────────────────────────────────────────────
OWNER_EMAIL=admin@easy-asphalt-driveway.store

# ─── Server Configuration ───────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0

# ─── Production Public URL ───────────────────────────────────────────────────
# This is the public HTTPS URL of your production application
VITE_API_BASE_URL=https://easy-asphalt-driveway.store
MOBILE_ALLOWED_ORIGINS=https://easy-asphalt-driveway.store

# ─── Email Service (Resend) ─────────────────────────────────────────────────────
# Get API key at: https://resend.com/api-keys
# Verify your domain at: https://resend.com/domains
RESEND_MASTER_API_KEY=<YOUR_RESEND_MASTER_KEY>
RESEND_API_KEY=<YOUR_RESEND_API_KEY>
EMAIL_FROM_ADDRESS=noreply@easy-asphalt-driveway.store

# ─── Sentry (Error Tracking & Performance Monitoring) ─────────────────────────
SENTRY_DSN=https://57f4e66333a9611af04d56f203acad1c@o4511361067974656.ingest.us.sentry.io/4511361068236800
SENTRY_ENVIRONMENT=production
SENTRY_ORG=easy-asphalt
SENTRY_PROJECT=easy-asphalt
SENTRY_AUTH_TOKEN=f34e30384bcb11f1b327c64fdd12ad4f
VITE_SENTRY_DSN=https://57f4e66333a9611af04d56f203acad1c@o4511361067974656.ingest.us.sentry.io/4511361068236800
VITE_SENTRY_ENVIRONMENT=production
VITE_APP_VERSION=1.0.0

# ─── Cloudflare Turnstile (CAPTCHA) ───────────────────────────────────────────
# Get keys at: https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SITE_KEY=<YOUR_TURNSTILE_SITE_KEY>
TURNSTILE_SECRET_KEY=<YOUR_TURNSTILE_SECRET_KEY>

# ─── Rate Limiting Configuration ─────────────────────────────────────────────
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX_REQUESTS=10
RATE_LIMIT_API_WINDOW_MS=60000
RATE_LIMIT_API_MAX_REQUESTS=100